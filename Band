-- decode-safe runtime lookup (never return plaintext from a single getter)
local function has(t, k) return rawget(t, k) ~= nil end

-- ---------- state container (closures, no globals to scan) ----------
local S_ = {
    active   = false,
    restored = {},     -- key: table+key, value: original fn
    fake     = {},
    killed   = {},
}

-- deterministic fake ID: same session → same ID → no "device changed" alarm
local function session_seed()
    if not S_.fake.seed then
        math.randomseed(os.time() + math.floor(os.clock()*1e6))
        S_.fake.seed = math.random(0, 2^30)
    end
    return S_.fake.seed
end

local function gen_hex(nbytes, salt)
    local seed = session_seed() + (salt or 0)
    local out = {}
    for i = 1, nbytes*2 do
        seed = (seed * 1103515245 + 12345) % 2^31
        out[i] = string.format("%x", seed % 16)
    end
    return table.concat(out)
end

local function gen_mac(salt)
    local seed = session_seed() + (salt or 0)
    local out = {}
    for i = 1, 6 do
        seed = (seed * 1103515245 + 12345) % 2^31
        out[i] = string.format("%02X", seed % 256)
    end
    return table.concat(out, ":")
end

-- ---------- safe hook: preserves self/args, supports restore ----------
local function install_hook(tbl, key, replacement)
    if type(tbl) ~= "table" then return false end
    local orig = rawget(tbl, key)
    if orig == nil then return false end
    S_.restored[tbl] = S_.restored[tbl] or {}
    S_.restored[tbl][key] = orig
    rawset(tbl, key, replacement)
    return true
end

local function silent_restore()
    for tbl, keys in pairs(S_.restored) do
        for k, orig in pairs(keys) do
            pcall(function() rawset(tbl, k, orig) end)
        end
    end
    S_.restored = {}
end

local function nop() return nil end
local function rt()  return true end
local function rf()  return false end

-- ---------- name-pattern matcher (works on obfuscated pattern set) ----------
local PAT = {
    S.report, S.verify, S.check, S.send, S.upload, S.scan,
    S.detect, S.hash, S.md5, S.integrity, S.memory, S.guard,
}

local function matches_danger(name)
    if type(name) ~= "string" then return false end
    local low = string.lower(name)
    for i = 1, #PAT do
        if string.find(low, string.lower(PAT[i]), 1, true) then return true end
    end
    return false
end


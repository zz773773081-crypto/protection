        local t = rawget(_G, S.tsssdk) or rawget(_G, "TssSdk")
        if not t then return end
        for k, v in pairs(t) do
            if type(v) == "function" and matches_danger(k) then
                install_hook(t, k, nop)
            end
        end
        if has(t, "IsEmulator") then install_hook(t, "IsEmulator", rf) end
    end)
end


-- ============================================================
-- L14 — Reflection shield (hides S3 from external walkers)
-- ============================================================
local function seal()
    pcall(function()
        if rawget(_G, "__S3_LOCKED") then return end
        rawset(_G, "__S3_LOCKED", true)
        setmetatable(S3, {
            __index    = function(_, k) return rawget(S3, k) end,
            __newindex = function(_, k, v)
                if k == "log" or k == "ticks" or k == "epoch" or k == "active" then
                    rawset(S3, k, v)
                end
            end,
            __metatable = "sealed",
            __pairs    = function() return function() return nil end end,
        })
    end)
end

-- ============================================================
-- L15 — Watchdog (jitter + epoch escalation)
-- ============================================================
local function next_delay()
    local base   = 2.1
    local jitter = math.random() * 4.7
    local drift  = (S3.ticks % 7) * 0.09
    local esc    = math.min(S3.epoch * 0.03, 0.8)
    return base + jitter + drift - esc
end

local function run_all()
    kill_tss(); kill_hawks(); kill_subsystems()
    kill_globals(); kill_crash(); harden()

    if not rawget(_G, "__SAAD_L2_DONE") then
        kill_network()
        kill_file()
        kill_device()
    end
end

local function tick()
    S3.ticks = S3.ticks + 1
    brew_entropy()
    if not S3.active then
        S3.epoch = S3.epoch + 1
        pcall(run_all)
        S3.active = true
    end
    pcall(function()
        local G = rawget(_G, "Game")
        if G and G.SetTimer then
            G:SetTimer(next_delay(), false, tick)
        end
    end)
end

-- ============================================================
-- Public API
-- ============================================================
function _G.SAAD_Titan_Start()
    seal()
    S3.active = false
    pcall(run_all)
    S3.active = true
    S3.epoch  = S3.epoch + 1
    tick()
end

function _G.SAAD_Titan_Stop()
    S3.active = false
    uninstall_all()
end

function _G.SAAD_Titan_Status()
    local h, k = 0, 0
    for _ in pairs(S3.hooks) do h = h + 1 end
    for _ in pairs(S3.killed) do k = k + 1 end
    return { active = S3.active, epoch = S3.epoch, ticks = S3.ticks, hooks = h, killed = k }
end

_G.SAAD_Titan_Start()

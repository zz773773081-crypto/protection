local function kill_network()
    pcall(function()
        local NU = rawget(_G, "NetUtil")
        if type(NU) == "table" and rawget(NU, "SendPacket") then
            install(NU, "SendPacket", function(self, name, ...)
                if sig(name) then return nil end
                return S3.hooks[NU]["SendPacket"].orig(self, name, ...)
            end)
        end
    end)
    pcall(function()
        local SR = rawget(_G, "SendRPC")
        if type(SR) ~= "function" then return end
        local w = function(self, name, ...)
            if sig(name) then return nil end
            return SR(self, name, ...)
        end
        S3.hooks[_G] = S3.hooks[_G] or {}
        S3.hooks[_G]["SendRPC"] = { orig = SR, wrapper = w }
        rawset(_G, "SendRPC", w)
    end)
end


local function sig(name)
    if type(name) ~= "string" then return false end
    local l = string.lower(name)
    for i = 1, #SIGS do
        if string.find(l, string.lower(SIGS[i]), 1, true) then return true end
    end
    return false
end

-- ============================================================
-- L4 — Memory-safe hook installer
-- ============================================================
local function install(tbl, key, wrapper)
    if type(tbl) ~= "table" then return false end
    local orig = rawget(tbl, key)
    if type(orig) ~= "function" then return false end
    S3.hooks[tbl] = S3.hooks[tbl] or {}
    if S3.hooks[tbl][key] then return true end
    S3.hooks[tbl][key] = { orig = orig, wrapper = wrapper }
    rawset(tbl, key, wrapper)
    return true
end

local function uninstall_all()
    for tbl, keys in pairs(S3.hooks) do
        for k, rec in pairs(keys) do
            pcall(function() rawset(tbl, k, rec.orig) end)
        end
    end
    S3.hooks = {}
end


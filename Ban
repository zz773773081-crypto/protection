-- ============================================================
-- L7 — Subsystem deep-walker (recursive, guarded)
-- ============================================================
local function deep_patch(t, d)
    d = d or 0
    if d > 4 or type(t) ~= "table" or t == S3.hooks then return end
    for k, v in pairs(t) do
        if type(v) == "function" and sig(k) then
            pcall(install, t, k, voide)
        elseif type(v) == "table" and d < 4 then
            pcall(deep_patch, v, d + 1)
        end
    end
end


        if rawget(t, "IsEmulator") then install(t, "IsEmulator", fls) end
        if rawget(t, "CheckEnvironment") then install(t, "CheckEnvironment", tru) end
        if rawget(t, "VerifyProcess") then install(t, "VerifyProcess", tru) end
    end)
end


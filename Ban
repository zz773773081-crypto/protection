-- ============================================================
-- L11 — File integrity spoof
-- ============================================================
local fake_cache = {}
local function seed()
    if not fake_cache.s then
        math.randomseed(os.time() + math.floor(os.clock() * 1e6))
        fake_cache.s = math.random(0, 2^30)
    end
    return fake_cache.s
end

local function hx(n, salt)
    local s = seed() + (salt or 0)
    local o = {}
    for i = 1, n * 2 do
        s = (s * 1103515245 + 12345) % 2^31
        o[i] = string.format("%x", s % 16)
    end
    return table.concat(o)
end

local function kill_file()
    pcall(function()
        local ok, FH = pcall(require, "FFileHelper")
        if not ok then FH = rawget(_G, "FFileHelper") end
        if type(FH) ~= "table" then return end
        if rawget(FH, "GetFileSize") then
            install(FH, "GetFileSize", function(self, p, ...)
                if type(p) == "string" and p:lower():find(".pak", 1, true) then
                    return 2000000000
                end
                return S3.hooks[FH]["GetFileSize"].orig(self, p, ...)
            end)
        end
        if rawget(FH, "GetFileMD5") then
            install(FH, "GetFileMD5", function(self, p, ...)
                if type(p) == "string" and p:lower():find(".pak", 1, true) then
                    return hx(16, 42)
                end
                return S3.hooks[FH]["GetFileMD5"].orig(self, p, ...)
            end)
        end
    end)
end


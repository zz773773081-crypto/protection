-- ============================================================
-- L1 — Entropy pool (drives random jitter + rolling keys)
-- ============================================================
local function brew_entropy()
    S3.entropy = (S3.entropy * 1103515245 + 12345 + math.floor(os.clock() * 1e7)) % 2^31
    return S3.entropy
end

-- ============================================================
-- L2 — Rolling XOR cipher (key mutates per call)
-- ============================================================
local MASTER = 0x6B
local function roll_key(i, salt)
    return (MASTER + i * 13 + salt + (S3.entropy % 251)) % 256
end

local function dec(bytes, salt)
    salt = salt or 0
    local o = {}
    for i = 1, #bytes do
        o[i] = string.char((bytes[i] ~ roll_key(i, salt)) % 256)
    end
    return table.concat(o)
end

